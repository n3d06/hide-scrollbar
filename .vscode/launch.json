{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🧪 npm run test (Kiểm tra lỗi & toàn vẹn)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "🌐 Chạy Chrome với Extension",
      "type": "chrome",
      "request": "launch",
      "url": "https://google.com",
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}/src"
      ],
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
    }
  ]
}
