{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
